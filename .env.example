# Google Gemini — 답장 코치 (Gemini 2.5 Flash)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 선택: GOOGLE_API_KEY 또는 GOOGLE_GENERATIVE_AI_API_KEY 도 동일하게 인식
GEMINI_MODEL=gemini-2.5-flash

# Django backend API base URL (include /api)
API_BASE_URL=

# Supabase (Renderer에서 NEXT_PUBLIC_ 접두사 필요)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
